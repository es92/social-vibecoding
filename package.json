{
  "name": "usernode-social-vibecoding",
  "version": "1.0.0",
  "private": true,
  "description": "Where the users are the developers are the users are the developers...",
  "main": "server.js",
  "bin": {
    "social-vibecoding": "tools/social-vibecoding"
  },
  "scripts": {
    "prestart": "node scripts/ensure-shell-artifacts.js --runtime",
    "start": "node server.js",
    "predev": "node scripts/ensure-shell-artifacts.js --runtime",
    "dev": "node --watch server.js",
    "pretest": "node scripts/ensure-shell-artifacts.js --html-only",
    "test": "node --require ./tests/lib/test-net.js --test --test-force-exit --test-timeout=180000 tests/*.test.js",
    "pretest:changed": "node scripts/ensure-shell-artifacts.js --html-only",
    "test:changed": "node scripts/test-changed.js",
    "test:shell-upgrade:browser": "node scripts/verify-shell-upgrade.js",
    "global-chat:inventory": "node scripts/generate-global-chat-inventory.js",
    "global-chat:inventory:check": "node scripts/generate-global-chat-inventory.js --check",
    "ensure:shell": "node scripts/ensure-shell-artifacts.js --runtime",
    "migrate:kubernetes": "node scripts/migrate-kubernetes.js",
    "cutover:native-delegation": "node scripts/cutover-native-delegation.js",
    "build:css": "node scripts/build-tailwind.js",
    "watch:css": "node scripts/build-tailwind.js --watch",
    "vendor:assets": "node scripts/vendor-assets.js",
    "build:shell": "node frontend/scripts/build-shell.mjs",
    "lint:sql": "node scripts/check-sql.js"
  },
  "devDependencies": {
    "dompurify": "3.4.4",
    "marked": "15.0.12",
    "pngjs": "7.0.0",
    "postgres": "3.4.9",
    "qrcodejs": "1.0.0",
    "tailwindcss": "3.4.17",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.89.0",
    "@kubernetes/client-node": "1.4.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@octokit/app": "^15.1.2",
    "@octokit/rest": "^22.0.1",
    "bcrypt": "^5.1.1",
    "bech32": "^2.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "express": "^4.21.0",
    "express-rate-limit": "^8.3.2",
    "firebase-admin": "^13.10.0",
    "jose": "^6.2.10",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "pg": "^8.13.0",
    "ws": "^8.18.0",
    "zod": "3.25.76"
  }
}
