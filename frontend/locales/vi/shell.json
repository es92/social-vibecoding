  "permissions.intro.androidProducer": {
    "text": "Điện thoại của bạn giúp vận hành Homeroom: nút của bạn có thể tạo khối khi ứng dụng chạy nền. Để làm vậy, Android cần đánh thức nút đúng giờ của từng slot và không áp dụng tối ưu hóa pin. Các cài đặt này chỉ lên lịch đánh thức. Homeroom không có quyền truy cập dữ liệu của bạn.",
    "source": "8954db94bb4bf9ce2ce1f373d9843fa198db0159c41ecc4798fa961371615722"
  },
  "permissions.intro.android": {
    "text": "Hãy cho phép thông báo để Homeroom báo cho bạn về hoạt động trên ứng dụng và nút của bạn.",
