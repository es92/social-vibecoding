  },
  "permissions.hint.background": {
    "text": "Android akan menanyakan apakah Homeroom boleh selalu berjalan di latar belakang, dan memperingatkan bahwa ini bisa memakai lebih banyak baterai. Ketuk Izinkan. Node-mu tetap tidur di antara slot, jadi dampaknya kecil, dan kamu bisa mengubahnya kapan saja di Pengaturan.",
    "source": "421a0c28fe464e54d18fcbc35778edc3061967bc4bb700f64c65194dc813131e"
  },
  "permissions.hint.delegate": {
    "text": "Tidak mau mengubah pengaturan ini? Delegasikan stake-mu ke server saja. Kamu tetap mendapat setengah poin produksi blok, dan bisa beralih kembali kapan saja.",
    "source": "e9d9991f4182fee315895aeee1c8034b8c752aa466fbe01646142829dc8e9acf"
  },
  "permissions.hint.productionDeferred": {
